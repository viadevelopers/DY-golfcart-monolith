# Development Docker ignore - optimized for local development

# Python runtime files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
*.egg-info/
dist/
build/

# Virtual environments (exclude from image)
.venv/
venv/
ENV/
env/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Version control
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
docs/
*.md
README*
LICENSE
CHANGELOG*

# Environment files (use env_file in compose instead)
.env
.env.*
!.env.example

# Test files (not needed in dev container - mounted as volume)
tests/
test_*.py
*_test.py
coverage/
.coverage
.coverage.*
htmlcov/

# Docker files (don't copy docker files into image)
Dockerfile*
docker-compose*.yml
.dockerignore

# Logs and temporary files
*.log
logs/
*.tmp
*.temp

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Development uploads (use volume mount instead)
uploads/

# Node.js (if any frontend assets)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database files (use volumes instead)
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup
*.orig
