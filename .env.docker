# Docker Environment Configuration
# Used when running inside Docker containers

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=dy-golfcart-dev-secret-key-change-in-production

# =============================================================================
# DATABASE CONFIGURATION (Docker service names)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/golfcart_db
TEST_DATABASE_URL=postgresql://postgres:postgres@postgres-test:5432/golfcart_test

# =============================================================================
# REDIS CONFIGURATION (Docker service name)
# =============================================================================
REDIS_URL=redis://:redis_dev_password@redis:6379/0

# =============================================================================
# MQTT CONFIGURATION (EMQX Cloud - Development)
# =============================================================================
MQTT_ENABLED=true
MQTT_BROKER_URL=emqx.dev.viasoft.ai
MQTT_PORT=8883
MQTT_USERNAME=admin
MQTT_PASSWORD=public
MQTT_CLIENT_ID=dy-golfcart-backend-dev-docker
MQTT_USE_TLS=true

# =============================================================================
# FILE STORAGE (Container path)
# =============================================================================
UPLOAD_DIR=/uploads