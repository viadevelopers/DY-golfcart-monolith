# Development Environment Configuration
# Automatically loaded when ENVIRONMENT=development

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
SECRET_KEY=dy-golfcart-dev-secret-key-change-in-production

# =============================================================================
# DATABASE CONFIGURATION (localhost for local development)
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/golfcart_db
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5436/golfcart_test

# =============================================================================
# REDIS CONFIGURATION (localhost)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# MQTT CONFIGURATION (EMQX Cloud - Development)
# =============================================================================
MQTT_ENABLED=true
MQTT_BROKER_URL=emqx.dev.viasoft.ai
MQTT_PORT=8883
MQTT_USERNAME=admin
MQTT_PASSWORD=public
MQTT_CLIENT_ID=dy-golfcart-backend-dev-local
MQTT_USE_TLS=true

# =============================================================================
# FILE STORAGE (Local Development)
# =============================================================================
UPLOAD_DIR=./uploads