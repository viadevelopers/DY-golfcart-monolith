# Development multi-stage build
FROM python:3.12.3-slim as builder

# Build arguments
ARG DEV_MODE=false

# Set working directory
WORKDIR /app

# Install system dependencies (including geospatial libs)
RUN apt-get update && apt-get install -y \
    # Build essentials
    gcc \
    g++ \
    make \
    pkg-config \
    # Database dependencies
    libpq-dev \
    # Geospatial dependencies (matching production)
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    # Development tools (only in dev mode)
    $([ "$DEV_MODE" = "true" ] && echo "git curl wget vim nano htop procps") \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --user --no-cache-dir -r requirements.txt \
    # Install development dependencies if in dev mode
    && if [ "$DEV_MODE" = "true" ]; then \
        pip install --user --no-cache-dir \
            pytest pytest-cov pytest-asyncio \
            black isort flake8 mypy \
            ipython ipdb \
            watchfiles \
            httpx; \
    fi

# Development runtime stage
FROM python:3.12.3-slim

# Build arguments
ARG DEV_MODE=false

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    # Health check tools
    curl \
    # Runtime geospatial libraries
    libgdal32 \
    libgeos3.11.1 \
    libproj25 \
    # Development tools (only in dev mode)
    $([ "$DEV_MODE" = "true" ] && echo "git vim nano htop procps net-tools") \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Create non-root user for security
RUN useradd -m -u 1000 appuser && \
    # Create necessary directories
    mkdir -p /uploads /var/log/golfcart && \
    chown -R appuser:appuser /uploads /var/log/golfcart

# Copy Python dependencies from builder to appuser's home
COPY --from=builder --chown=appuser:appuser /root/.local /home/appuser/.local

# Set environment variables
ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Copy application code (in dev mode, this will be mounted as volume)
COPY --chown=appuser:appuser ./app ./app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check (adjusted for development)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default development command with hot reload
# This can be overridden in docker-compose.dev.yml
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app"]
