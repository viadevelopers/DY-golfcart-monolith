# DY Golf Cart Monolith - Environment Variables Template
# Copy this file to .env.local and customize values for your environment
# DO NOT commit .env.local to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production
ENVIRONMENT=production

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/golfcart_db
TEST_DATABASE_URL=postgresql://username:password@localhost:5436/golfcart_test

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# MQTT CONFIGURATION
# =============================================================================
MQTT_ENABLED=true
MQTT_BROKER_URL=your-mqtt-broker-url
MQTT_PORT=1883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
MQTT_CLIENT_ID=dy-golfcart-backend
MQTT_USE_TLS=false

# =============================================================================
# FILE STORAGE
# =============================================================================
UPLOAD_DIR=/uploads
# For S3 storage (optional)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=your-bucket-name
# AWS_REGION=us-west-2

# =============================================================================
# EXTERNAL SERVICES (Optional)
# =============================================================================
# Email configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email
# SMTP_PASSWORD=your-password
# SMTP_USE_TLS=true
